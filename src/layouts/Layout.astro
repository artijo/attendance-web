---
import "../global.css";
const {
    title = "ระบบบันทึกการเข้าเรียนของนักเรียน",
    description = "ระบบบันทึกและติดตามการเข้าเรียนและกิจกรรมของนักเรียน โรงเรียนน้ำพองศึกษา",
} = Astro.props;
---

<html lang="th">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="canonical" href={Astro.url} />
        <meta name="theme-color" content="#0054A6" />
        <!-- SEO -->
        <meta
            name="keywords"
            content="ระบบบันทึกการเข้าเรียน, นักเรียน, attendance system, student attendance, โรงเรียนน้ำพองศึกษา"
        />
        <meta name="robots" content="noindex" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content="/cover_web.jpg" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:locale" content="th_TH" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content="/cover_web.jpg" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="preconnect" href="https://student.att.nps.ac.th" />
        <link rel="preconnect" href="https://teacher.att.nps.ac.th" />
        <link rel="preconnect" href="https://manage.att.nps.ac.th" />
    </head>
    <body>
        <slot />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
